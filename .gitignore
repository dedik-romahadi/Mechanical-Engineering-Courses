# Codex workspace metadata
.codex/

# Node / Firebase
node_modules/
.firebase/
*.log

# Slidev build output
dist/
.slidev/

# Video kerja / sumber (besar — jangan commit; host eksternal atau Git LFS)
PDD-UKTPT/Video/*
!PDD-UKTPT/Video/index.html
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.m4v

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Salinan konflik OneDrive — dibuat otomatis saat file yang sama disunting di
# dua perangkat. Formatnya "<nama>-<NAMA-PC>.<ext>" dan isinya SELALU snapshot
# lama, bukan kerja baru; jangan pernah di-commit. Tambahkan nama PC lain di
# sini bila muncul.
*-DEDIK-PC.*

# Local environment
.env
.env.local
*.local

# Service account keys (NEVER commit)
*-service-account*.json
firebase-adminsdk-*.json

# Artefak Python
__pycache__/
*.pyc
