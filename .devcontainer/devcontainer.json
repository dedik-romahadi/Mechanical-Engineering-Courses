{
  "name": "Getaran Mekanik — Slidev Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "workspaceFolder": "/workspaces/Mechanical-Engineering-Courses",
  "forwardPorts": [3030],
  "portsAttributes": {
    "3030": {
      "label": "Slidev Preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "cd Getaran-Mekanik/Slides && npm install",
  "postStartCommand": "cd Getaran-Mekanik/Slides && npm run dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "vue.volar",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "formulahendry.auto-rename-tag",
        "catppuccin.catppuccin-vsc"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.wordWrap": "on",
        "files.autoSave": "afterDelay"
      }
    }
  }
}
