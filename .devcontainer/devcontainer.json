{
  "name": "Mechanical Engineering Courses — Slidev Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "workspaceFolder": "/workspaces/Mechanical-Engineering-Courses",
  "forwardPorts": [3030, 3031],
  "portsAttributes": {
    "3030": {
      "label": "Slidev · Getaran Mekanik",
      "onAutoForward": "openBrowser"
    },
    "3031": {
      "label": "Slidev · Opto Machine Learning",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "cd Getaran-Mekanik/Slides && npm install && cd /workspaces/Mechanical-Engineering-Courses/Optimalisasi-dan-Automasi/Slides && npm install",
  "postStartCommand": {
    "getaran-slides": "cd Getaran-Mekanik/Slides && npm run dev",
    "opto-slides": "cd Optimalisasi-dan-Automasi/Slides && npm run dev"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vue.volar",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "formulahendry.auto-rename-tag",
        "catppuccin.catppuccin-vsc"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.wordWrap": "on",
        "files.autoSave": "afterDelay"
      }
    }
  }
}
