{
  "name": "exam-validation-functions",
  "description": "Cloud Functions untuk validasi jawaban exam server-side (pilot: Getaran Mekanik UTS).",
  "version": "1.1.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "echo 'No linter configured yet.'",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed": "node seed/seed-firestore.js --exam getaran-mekanik-uts",
    "seed:uts": "node seed/seed-firestore.js --exam getaran-mekanik-uts",
    "seed:uas": "node seed/seed-firestore.js --exam getaran-mekanik-uas",
    "seed:all": "node seed/seed-firestore.js --all",
    "seed:list": "node seed/seed-firestore.js --list"
  },
  "dependencies": {
    "firebase-admin": "^12.5.0",
    "firebase-functions": "^6.0.1"
  }
}
